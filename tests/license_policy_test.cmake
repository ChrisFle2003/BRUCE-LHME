cmake_minimum_required(VERSION 3.25)

get_filename_component(repository_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

function(read_required relative_path output)
  set(path "${repository_root}/${relative_path}")
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "Required licensing file is missing: ${relative_path}")
  endif()
  file(READ "${path}" contents)
  set(${output} "${contents}" PARENT_SCOPE)
endfunction()

function(require_text label contents expected)
  string(FIND "${contents}" "${expected}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "${label} is missing required text: ${expected}")
  endif()
endfunction()

function(forbid_text label contents forbidden)
  string(FIND "${contents}" "${forbidden}" position)
  if(NOT position EQUAL -1)
    message(FATAL_ERROR "${label} still contains forbidden text: ${forbidden}")
  endif()
endfunction()

read_required("LICENSE" license)
require_text("LICENSE" "${license}" "Copyright (c) 2026 Christopher Flegel")
require_text("LICENSE" "${license}" "SPDX-License-Identifier: EUPL-1.2+")
require_text("LICENSE" "${license}" "Licensed under the EUPL-1.2-or-later.")
require_text("LICENSE" "${license}" "EUROPEAN UNION PUBLIC LICENCE v. 1.2")
require_text("LICENSE" "${license}" "EUPL © the European Union 2007, 2016")
require_text("LICENSE" "${license}" "15. Applicable Law")
forbid_text("LICENSE" "${license}" "MIT License")

foreach(readme IN ITEMS README.en.md README.md)
  read_required("${readme}" contents)
  require_text("${readme}" "${contents}" "EUPL-1.2-or-later")
  forbid_text("${readme}" "${contents}" "MIT License")
endforeach()

read_required("docs/developer-guide.en.md" developer_guide)
require_text("docs/developer-guide.en.md" "${developer_guide}" "EUPL-1.2-or-later")
forbid_text("docs/developer-guide.en.md" "${developer_guide}" "LICENSE                        MIT license")

read_required("CONTRIBUTING.md" contributing)
require_text("CONTRIBUTING.md" "${contributing}" "Developer Certificate of Origin")
require_text("CONTRIBUTING.md" "${contributing}" "Signed-off-by:")
require_text("CONTRIBUTING.md" "${contributing}" "EUPL-1.2-or-later")
